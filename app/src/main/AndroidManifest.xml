<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".EduCenterApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_school_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_school_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.EduCenter">

        <!-- Splash Activity: Application Launcher -->
        <activity
            android:name=".view.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EduCenter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth Activities -->
        <activity
            android:name=".view.activity.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".view.activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard & Module Activities -->
        <activity
            android:name=".view.activity.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".view.activity.StatisticsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
