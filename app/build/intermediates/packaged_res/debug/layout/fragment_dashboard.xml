<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <!-- Welcome Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWelcome"
                style="@style/Widget.EduCenter.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Xin chào,"
                        android:textColor="@color/primary_light"
                        android:textSize="@dimen/text_size_body" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Trần Quản Trị"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_heading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDateDisplay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif"
                            android:text="Hôm nay: 01/11/2026"
                            android:textColor="@color/primary_light"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:id="@+id/tvHeaderRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_primary"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:text="Quản trị viên"
                            android:textColor="@color/primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title: Overview Metrics -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_8"
                android:fontFamily="sans-serif-bold"
                android:text="Thống kê tổng quan"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_subheading" />

            <!-- 4 Metrics Grid (2 Rows x 2 Columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Stat 1: Học sinh đang học -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EduCenter.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/stat_students_count"
                            android:src="@drawable/ic_students"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tvStatStudents"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_students_count"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 2: Lớp đang mở -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EduCenter.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/stat_classes_count"
                            android:src="@drawable/ic_classes"
                            app:tint="@color/success" />

                        <TextView
                            android:id="@+id/tvStatClasses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_classes_count"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:orientation="horizontal">

                <!-- Stat 3: Giáo viên hoạt động -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EduCenter.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/stat_teachers_count"
                            android:src="@drawable/ic_teachers"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/tvStatTeachers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_teachers_count"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stat 4: Doanh thu tháng -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.EduCenter.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/stat_month_revenue"
                            android:src="@drawable/ic_tuition"
                            app:tint="@color/warning" />

                        <TextView
                            android:id="@+id/tvStatRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:fontFamily="sans-serif-black"
                            android:text="0 ₫"
                            android:textColor="@color/text_main"
                            android:textSize="@dimen/text_size_subheading" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stat_month_revenue"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Quick Actions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:layout_marginBottom="@dimen/spacing_8"
                android:fontFamily="sans-serif-bold"
                android:text="@string/quick_actions"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_subheading" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EduCenter.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Action: Quản lý học sinh -->
                        <LinearLayout
                            android:id="@+id/actionStudents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_8">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_students"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="Học sinh"
                                android:textColor="@color/text_main"
                                android:textSize="@dimen/text_size_body_small" />
                        </LinearLayout>

                        <!-- Action: Quản lý lớp học -->
                        <LinearLayout
                            android:id="@+id/actionClasses"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_8">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_classes"
                                app:tint="@color/success" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="Lớp học"
                                android:textColor="@color/text_main"
                                android:textSize="@dimen/text_size_body_small" />
                        </LinearLayout>

                        <!-- Action: Điểm danh -->
                        <LinearLayout
                            android:id="@+id/actionAttendance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_8">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_attendance"
                                app:tint="@color/primary_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="Điểm danh"
                                android:textColor="@color/text_main"
                                android:textSize="@dimen/text_size_body_small" />
                        </LinearLayout>

                        <!-- Action: Thống kê -->
                        <LinearLayout
                            android:id="@+id/actionStats"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_8">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_statistics"
                                app:tint="@color/secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:text="Thống kê"
                                android:textColor="@color/text_main"
                                android:textSize="@dimen/text_size_body_small" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Revenue Trend Chart Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:layout_marginBottom="@dimen/spacing_8"
                android:fontFamily="sans-serif-bold"
                android:text="Xu hướng doanh thu 6 tháng gần nhất"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_subheading" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EduCenter.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12">

                    <com.educenter.app.view.customview.BarChartView
                        android:id="@+id/dashboardBarChart"
                        android:layout_width="match_parent"
                        android:layout_height="170dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Title: Recent Activities -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:layout_marginBottom="@dimen/spacing_8"
                android:fontFamily="sans-serif-bold"
                android:text="@string/recent_activities"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_subheading" />

            <!-- Recent Activities List Container -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EduCenter.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/layoutRecentActivities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_12" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_24" />

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
