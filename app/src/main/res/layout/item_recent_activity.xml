<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_8">

    <ImageView
        android:id="@+id/ivActivityIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_badge_primary"
        android:padding="@dimen/spacing_6"
        android:src="@drawable/ic_tuition"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActivityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Tiêu đề hoạt động"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:id="@+id/tvActivityDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả chi tiết"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActivityTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01/11"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_size_caption" />
</LinearLayout>
