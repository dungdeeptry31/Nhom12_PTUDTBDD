<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="@dimen/spacing_20">

    <!-- Header & Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="Thu học phí"
            android:textColor="@color/text_main"
            android:textSize="@dimen/text_size_heading" />

        <ImageView
            android:id="@+id/btnPaymentClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Invoice Summary Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.EduCenter.CardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:cardBackgroundColor="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPaymentInvoiceCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="HD202611-001"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/tvPaymentMonthYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tháng 11/2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPaymentStudentInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Học sinh: Vũ Mai Phương (HS006)"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_body_small" />

            <TextView
                android:id="@+id/tvPaymentClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lớp: Toán 12 Nâng cao"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="@dimen/spacing_8"
                android:background="@color/border" />

            <!-- Amounts: Total, Paid, Debt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng học phí"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPaymentTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="1.500.000 ₫"
                        android:textColor="@color/text_main"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã nộp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPaymentPaidAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="500.000 ₫"
                        android:textColor="@color/success"
                        android:textSize="@dimen/text_size_body_small" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Còn nợ"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPaymentRemainingDebt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="1.000.000 ₫"
                        android:textColor="@color/error"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Payment Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentAmount"
        style="@style/Widget.EduCenter.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:hint="Số tiền thanh toán (VNĐ) *">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Fill Full Debt Button -->
    <TextView
        android:id="@+id/tvFillFullDebt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:padding="4dp"
        android:text="⚡ Nộp toàn bộ số tiền nợ"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <!-- Payment Method Radio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:fontFamily="sans-serif-medium"
        android:text="Hình thức thanh toán:"
        android:textColor="@color/text_main"
        android:textSize="@dimen/text_size_body_small" />

    <RadioGroup
        android:id="@+id/rgPaymentMethod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbTransfer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Chuyển khoản"
            android:textColor="@color/text_main" />

        <RadioButton
            android:id="@+id/rbCash"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tiền mặt"
            android:textColor="@color/text_main" />
    </RadioGroup>

    <!-- Payment Note -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentNote"
        style="@style/Widget.EduCenter.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:hint="Ghi chú thu tiền (tùy chọn)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPaymentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPayment"
        style="@style/Widget.EduCenter.Button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_8"
        android:text="Xác nhận thanh toán" />

</LinearLayout>
