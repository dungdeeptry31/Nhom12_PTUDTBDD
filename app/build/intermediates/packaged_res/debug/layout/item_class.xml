<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.EduCenter.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_16"
    android:layout_marginVertical="@dimen/spacing_6"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_16">

        <!-- Top Row: Class Name, Code, and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="Toán 12 Nâng cao"
                android:textColor="@color/text_main"
                android:textSize="@dimen/text_size_subheading" />

            <TextView
                android:id="@+id/tvClassStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_8"
                android:background="@drawable/bg_badge_success"
                android:fontFamily="sans-serif-medium"
                android:text="@string/status_open"
                android:textColor="@color/success"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Code & Subject -->
        <TextView
            android:id="@+id/tvClassCodeAndSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:text="Mã: TOAN12A  •  Môn: Toán 12"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_body_small" />

        <!-- Teacher & Room -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClassTeacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="GV: Nguyễn Văn An"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <TextView
                android:id="@+id/tvClassRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phòng: P.101"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/spacing_8"
            android:background="@color/border" />

        <!-- Capacity Progress & Tuition Fee -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCapacityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sĩ số: 12 / 25 học sinh"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_caption" />

                <ProgressBar
                    android:id="@+id/progressCapacity"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:max="100"
                    android:progress="48"
                    android:progressTint="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTuitionFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="1.500.000 ₫/tháng"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
